# --- GitHub bridge (unchanged from the original bridge) ---
GITHUB_TOKEN=
MCP_ADMIN_SECRET=
MCP_JWT_SECRET=
MCP_BASE_URL=https://your-service.onrender.com
# Repos Claude may READ. "owner/repo", "owner/*", or "*" (every repo the token can reach; avoid).
ALLOWED_REPOS=Seizethewind/*
# Repos Claude may WRITE to (commit, delete, create branches). Same syntax; keep it narrower than
# ALLOWED_REPOS. If unset it falls back to ALLOWED_REPOS.
# WRITE_REPOS=Seizethewind/LilyAiClaudeMemoryMcpPlugin
# Writes straight to a repo's default branch are refused so changes go through a branch + pull request.
# ALLOW_DEFAULT_BRANCH_WRITES=true
PORT=3232

# --- Turso memory ---
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=

# Removed memory stays restorable this many days before it is erased for good (default 30).
# Server-wide wipe / emptying the trash / unlocking happen only on /admin/memory (admin secret).
# TRASH_RETENTION_DAYS=30

# --- Optional nightly backup of memories to a PRIVATE GitHub repo ---
# BACKUP_REPO=Seizethewind/lily-memory-backup
# BACKUP_PATH=memory-backup/memories.jsonl
# BACKUP_BRANCH=main
# BACKUP_INTERVAL_HOURS=24

# --- Optional Tavily web search (web_search, web_extract) ---
# One key, or several separated by commas: calls rotate k1, k2, k3, k1, ... A key over its limit is skipped.
# TAVILY_API_KEY=tvly-key1,tvly-key2
# TAVILY_API_URL=https://api.tavily.com

# --- Optional PandaStack sandboxes (microVMs with Chromium + Playwright) ---
# Create a token in the PandaStack dashboard under API Tokens. Tools only appear when this is set.
# One key, or several separated by commas: new work rotates k1, k2, k3, k1, ... (any number of keys).
# PANDASTACK_API_KEY=pds_key1,pds_key2,pds_key3
# PANDASTACK_API_URL=https://api.pandastack.ai
# Preview URL suffix; defaults to the API host without "api." (set it when self-hosting).
# PANDASTACK_PREVIEW_HOST=pandastack.ai
# How many live sandboxes this bridge may hold, default lifetime and hard lifetime ceiling.
# SANDBOX_MAX_ACTIVE=3
# SANDBOX_DEFAULT_TTL_SECONDS=900
# SANDBOX_MAX_TTL_SECONDS=3600
# core (default): 14 everyday tools + pandastack_api for the rest. full: all 57 tools (costs more context every session).
# SANDBOX_TOOLSET=core

# Self-ping keeps Render's free tier awake. SELF_PING=false to disable.
# SELF_PING_INTERVAL_MS=600000
