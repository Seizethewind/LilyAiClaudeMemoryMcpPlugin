# --- GitHub bridge (unchanged from the original bridge) ---
GITHUB_TOKEN=
MCP_ADMIN_SECRET=
MCP_JWT_SECRET=
MCP_BASE_URL=https://your-service.onrender.com
# "*" = any repo the token can reach. Narrower: "Seizethewind/*,UmakraftCircle/*"
ALLOWED_REPOS=*
PORT=3232

# --- Turso memory ---
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=

# Removed memory stays restorable this many days before it is erased for good (default 30).
# Server-wide wipe / emptying the trash / unlocking happen only on /admin/memory (admin secret).
# TRASH_RETENTION_DAYS=30

# --- Optional nightly backup of memories to a PRIVATE GitHub repo ---
# BACKUP_REPO=Seizethewind/lily-memory-backup
# BACKUP_PATH=memory-backup/memories.jsonl
# BACKUP_BRANCH=main
# BACKUP_INTERVAL_HOURS=24

# Self-ping keeps Render's free tier awake. SELF_PING=false to disable.
# SELF_PING_INTERVAL_MS=600000
